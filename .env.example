# 默认 SSH 主机（可选）。
# 不配置本节时，服务器启动后没有任何主机，只能通过 add_host 工具动态添加。
SSH_DEFAULT_NAME=default
SSH_DEFAULT_HOST=192.168.1.10
SSH_DEFAULT_PORT=22
SSH_DEFAULT_USER=your_user

# 认证方式：密码 与 私钥 二选一
SSH_DEFAULT_PASSWORD=your_password
# SSH_DEFAULT_PRIVATE_KEY_PATH=C:\Users\you\.ssh\id_ed25519
# SSH_DEFAULT_PASSPHRASE=
